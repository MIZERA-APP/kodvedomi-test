# Kód Vědomí – zabezpečení a výkon na hostingu Wedos (Apache)

# Vždy přes HTTPS a bez „www“
RewriteEngine On
RewriteCond %{HTTPS} !=on
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
RewriteRule ^ https://%1%{REQUEST_URI} [L,R=301]

# Žádné výpisy složek, skryté soubory (.git, .env…) nejsou dostupné
Options -Indexes
RewriteRule (^|/)\.(?!well-known/) - [F,L]
<FilesMatch "\.(map|md|sql|json|lock|log|bak|zip)$">
  Require all denied
</FilesMatch>

<IfModule mod_headers.c>
  # Prohlížeč smí web otevírat jen přes HTTPS (1 rok)
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
  # Web nejde vložit do cizí stránky (ochrana proti clickjackingu)
  Header always set X-Frame-Options "DENY"
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(self)"
  Header always set Cross-Origin-Opener-Policy "same-origin"
  # Odkud smí web načítat skripty, styly, písma, obrázky a data
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: blob: https://*.supabase.co; media-src 'self' https://*.supabase.co; connect-src 'self' https://*.supabase.co wss://*.supabase.co; frame-ancestors 'none'; base-uri 'self'; form-action 'self' mailto:; object-src 'none'; upgrade-insecure-requests"
  Header always unset X-Powered-By

  # Soubory s otiskem v názvu se cachují dlouho, index.html nikdy
  <FilesMatch "\.(js|css|webp|png|jpg|svg|woff2|mp4)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "^index\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript image/svg+xml
</IfModule>
